DATABASE_URL="postgresql://silas_admin:silas_secret_password@localhost:5432/silas_db"
PORT=3000
# 32-byte (64 hex char) AES-256 key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULE_LOCK_ENCRYPTION_KEY=replace-with-a-generated-64-char-hex-key
# 32-byte (64 hex char) AES-256 key for sealing third-party integration credentials at rest.
INTEGRATION_CREDENTIAL_KEY=replace-with-a-generated-64-char-hex-key
# Random secret for signing JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-generated-random-secret
JWT_EXPIRES_IN=8h
# Password reset emails (packages/email, sent via Resend).
RESEND_API_KEY=replace-with-a-real-resend-api-key
PASSWORD_RESET_EMAIL_FROM="SILAS <no-reply@silaserv.com>"
# Base URL (no trailing path) of each frontend the reset link can point at --
# never taken from the request itself, only these fixed, server-controlled
# values. Only set the ones actually deployed.
CLIENT_PORTAL_URL=http://localhost:3006
STAFF_CONSOLE_URL=http://localhost:3002
WEB_CLIENT_URL=http://localhost:3001
